                "Content-Type": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"email\": \"not-an-email\",\n  \"password\": \"weak\",\n  \"role\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Expects 400 with an errors[] array: short name, bad email, weak password, admin not self-assignable."
          }
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "Content-Type": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@school.test\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Seeded admin: admin@school.test / Admin@123"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"adminToken\", pm.response.json().data.token);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 - admin logged in', () => pm.response.to.have.status(200));",
                  "pm.test('token returned', () => pm.expect(pm.response.json().data.token).to.be.a('string'));",
                  "pm.test('password never returned', () => pm.expect(pm.response.text()).to.not.include('password'));"
                ]
              }
            }
          ]
        },
