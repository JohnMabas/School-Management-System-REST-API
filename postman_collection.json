              "raw": "{\n  \"name\": \"Zainab Bello\",\n  \"email\": \"zainab.bello@school.test\",\n  \"password\": \"Str0ng!pass\",\n  \"role\": \"student\",\n  \"phone\": \"+2348030000001\",\n  \"classId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Creates a login and the matching student record. 409/400 if the email exists."
          }
        },
